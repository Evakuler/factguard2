{
  "manifest_version": 3,
  "name": "FactGuard — Перевірка новин",
  "version": "2.1.0",
  "description": "Перевірка новин: джерело, ознаки маніпуляції, пошук на інших сайтах, ШІ-аналіз, захист від фішингу з білим і чорним списками.",
  "minimum_chrome_version": "102",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://cdn.jsdelivr.net/*",
    "https://rdap.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FactGuard — Перевірка новин",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/analyzer.js",
        "src/news-analyzer.js",
        "src/ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
